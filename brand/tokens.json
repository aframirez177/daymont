{
  "$description": "Daymont design tokens. Single source of truth for web, Figma and the Claude design system. Default palette: taller.",
  "color": {
    "modes": ["taller", "azul", "acero"],
    "default": "taller",
    "tokens": {
      "bg":        { "taller": "#0E0E0E", "azul": "#0A1624", "acero": "#F4F2EC", "role": "Page ground" },
      "surface":   { "taller": "#1A1A19", "azul": "#10233A", "acero": "#E7E4DC", "role": "Cards, panels" },
      "surface-2": { "taller": "#242422", "azul": "#16304D", "acero": "#DAD6CC", "role": "Raised / hover surface" },
      "line":      { "taller": "#2E2D2A", "azul": "#1E3A55", "acero": "#C9C6BE", "role": "Borders, construction lines" },
      "muted":     { "taller": "#8A8984", "azul": "#7C8A96", "acero": "#5E6166", "role": "Secondary text, labels" },
      "text":      { "taller": "#E8E6E1", "azul": "#EEF1F3", "acero": "#141414", "role": "Primary text" },
      "accent":    { "taller": "#F24E1E", "azul": "#FFB000", "acero": "#FFD100", "role": "Fills: CTA, highlights" },
      "accent-ink":{ "taller": "#F24E1E", "azul": "#FFB000", "acero": "#141414", "role": "Accent used as text/lines on bg" },
      "on-accent": { "taller": "#0E0E0E", "azul": "#0A1624", "acero": "#141414", "role": "Text on accent fill" },
      "brand":     { "taller": "#F24E1E", "azul": "#FFB000", "acero": "#141414", "role": "Logo color" }
    }
  },
  "font": {
    "display": { "family": "Barlow Condensed", "weights": [700, 800, 900], "case": "uppercase", "use": "Headlines, big numbers" },
    "body":    { "family": "Barlow", "weights": [400, 500, 600], "use": "Running text, UI" },
    "mono":    { "family": "JetBrains Mono", "weights": [400, 500, 700], "case": "uppercase labels", "use": "Specs, references, labels, lot numbers" }
  },
  "type": {
    "display-xl": { "font": "display", "weight": 900, "size": 184, "sizeMobile": 72, "lineHeight": 0.84, "tracking": 0 },
    "display-l":  { "font": "display", "weight": 900, "size": 120, "sizeMobile": 56, "lineHeight": 0.86, "tracking": 0 },
    "h1":         { "font": "display", "weight": 800, "size": 76,  "sizeMobile": 44, "lineHeight": 0.92, "tracking": 0 },
    "h2":         { "font": "display", "weight": 800, "size": 48,  "sizeMobile": 34, "lineHeight": 0.95, "tracking": 0 },
    "h3":         { "font": "display", "weight": 700, "size": 28,  "sizeMobile": 24, "lineHeight": 1.0,  "tracking": 0 },
    "lead":       { "font": "body", "weight": 400, "size": 20, "lineHeight": 1.5 },
    "body":       { "font": "body", "weight": 400, "size": 17, "lineHeight": 1.55 },
    "small":      { "font": "body", "weight": 400, "size": 14, "lineHeight": 1.5 },
    "label":      { "font": "mono", "weight": 500, "size": 12, "lineHeight": 1.3, "tracking": 0.06, "case": "upper" },
    "data":       { "font": "mono", "weight": 500, "size": 32, "lineHeight": 1.05 }
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128],
  "radius": { "none": 0, "sm": 2, "icon": 14 },
  "line": { "construction": { "width": 1, "dash": [4, 4], "color": "line" }, "axis": { "width": 1, "dash": [2, 6], "color": "accent-ink", "opacity": 0.6 } },
  "grid": { "columns": 12, "maxWidth": 1280, "gutter": 24, "margin": { "mobile": 16, "desktop": 40 }, "logoUnit": "Logo drawn on user's own geometry (viewBox 83x36); do not redraw" },
  "logo": {
    "files": ["daymont-mark.svg", "daymont-horizontal.svg", "daymont-vertical.svg"],
    "rule": "Geometry exactly as drawn by Álvaro. Only the fill color changes (brand token).",
    "clearspace": "Height of the rod stroke x2 on every side",
    "minSize": { "mark": "24px wide", "horizontal": "96px wide" }
  }
}
