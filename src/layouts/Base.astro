---
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource/barlow-condensed/900.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import logoH from '../../brand/daymont-horizontal.svg?raw';
import logoV from '../../brand/daymont-vertical.svg?raw';
import { company, wa, solutions } from '../data/site.js';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  schema?: object[];
}
const { title, description, path = '', noindex = false, schema = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const u = (p = '') => `${base}${p}`.replace(/\/{2,}/g, '/');
const canonical = new URL(u(path), Astro.site).href;
const ogImage = new URL(u('og.png'), Astro.site).href;
const siteUrl = new URL(u(''), Astro.site).href;
const strip = (s: string) => s.replace(/fill="#[0-9A-Fa-f]{6}"/g, 'fill="currentColor"').replace(/width="\d+" height="\d+" /, '');

const org = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${siteUrl}#org`,
  name: company.name,
  alternateName: [company.short, company.meaning],
  description: `Fabricante de cilindros hidráulicos y neumáticos en Bogotá desde ${company.founded}: diseño, fabricación, reparación y distribución de componentes hidráulicos y neumáticos.`,
  foundingDate: String(company.founded),
  url: siteUrl,
  logo: new URL(u('daymont-mark.svg'), Astro.site).href,
  telephone: company.phone,
  address: { '@type': 'PostalAddress', streetAddress: company.address, addressLocality: 'Bogotá', addressRegion: 'Bogotá D.C.', addressCountry: 'CO' },
  areaServed: { '@type': 'Country', name: 'Colombia' },
  knowsAbout: ['cilindros hidráulicos', 'cilindros neumáticos', 'reparación de cilindros', 'bombas de paletas Vickers', 'mecanizado CNC', 'impresión 3D'],
  sameAs: [company.youtube],
};
const jsonld = [org, ...schema];
const waDefault = wa('Hola Daymont, necesito información sobre un cilindro.');
---
<!doctype html>
<html lang="es-CO" data-palette="taller">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#0E0E0E" />
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
  <link rel="sitemap" href={u('sitemap-index.xml')} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:site_name" content="Daymont" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="geo.region" content="CO-DC" />
  <meta name="geo.placename" content="Bogotá" />
  <script is:inline>
    (function () {
      var d = document.documentElement; d.classList.add('js');
      try { var p = localStorage.getItem('daymont-palette'); if (p === 'taller' || p === 'azul' || p === 'acero') d.setAttribute('data-palette', p); } catch (e) {}
    })();
  </script>
  {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body>
  <a class="skip" href="#main">Saltar al contenido</a>
  <div class="page-rails" aria-hidden="true"><div class="wrap"><i></i><i></i></div></div>
  {path === '' && (
    <aside class="hud" aria-label="Índice de secciones">
      <div class="hud-ruler" aria-hidden="true"><span class="hud-mark"></span></div>
      <ol class="hud-idx">
        <li data-target="inicio">00 Inicio</li><li data-target="soluciones">01 Puertas</li><li data-target="armado">·· Armado</li>
        <li data-target="taller">02 Taller</li><li data-target="catalogo">03 Línea</li><li data-target="configurador">04 Configurar</li>
        <li data-target="reparar">05 Reparar</li><li data-target="confianza">06 Confianza</li><li data-target="preguntas">07 FAQ</li><li data-target="contacto">08 Contacto</li>
      </ol>
      <div class="hud-read label" aria-hidden="true"><span>Y <b data-y>000000</b></span><span data-sec></span></div>
    </aside>
  )}
  <div class="crosshair" aria-hidden="true"><i class="cx"></i><i class="cy"></i><span class="cc"></span></div>

  <header class="site-header">
    <div class="wrap">
      <a class="brand" href={u('')} aria-label="Daymont, inicio" set:html={strip(logoH)} />
      <nav class="nav" aria-label="Principal">
        <a href={u('#soluciones')}>Soluciones</a>
        <a href={u('#armado')}>Cómo fabricamos</a>
        <a href={u('#taller')}>Taller</a>
        <a href={u('#configurador')}>Configurador</a>
        <a href={u('estrategia/')} aria-current={path === 'estrategia/' ? 'page' : undefined}>Estrategia</a>
      </nav>
      <div class="palette" role="group" aria-label="Paleta de color (propuesta)">
        <button type="button" data-pal="taller" style="--sw:#F24E1E;--sw-bg:#0E0E0E" aria-pressed="true" title="01 Taller"><span class="sr-only">Paleta Taller</span></button>
        <button type="button" data-pal="azul" style="--sw:#FFB000;--sw-bg:#0A1624" aria-pressed="false" title="02 Azul hidráulico"><span class="sr-only">Paleta Azul hidráulico</span></button>
        <button type="button" data-pal="acero" style="--sw:#FFD100;--sw-bg:#F4F2EC" aria-pressed="false" title="03 Acero"><span class="sr-only">Paleta Acero</span></button>
      </div>
      <a class="btn primary" href={u('#configurador')} data-track="header_cotizar"><span class="txt">Cotizar</span> <span class="arr">→</span></a>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="grid">
        <div style="display:grid;gap:18px;align-content:start">
          <div class="logo-v" set:html={strip(logoV)} />
          <p class="small muted">{company.meaning}. Cilindros hidráulicos y neumáticos, hechos en Bogotá desde {company.founded}.</p>
        </div>
        <div>
          <p class="label" style="margin-bottom:12px">Soluciones</p>
          <ul>{solutions.map((s) => <li><a href={u(`soluciones/${s.slug}/`)}>{s.short}</a></li>)}</ul>
        </div>
        <div>
          <p class="label" style="margin-bottom:12px">Contacto</p>
          <ul>
            <li>{company.address}</li>
            <li>{company.city}, Colombia</li>
            <li><a href={`tel:${company.phone.replace(/\s/g, '')}`}>{company.phoneDisplay}</a></li>
            <li><a href={waDefault} target="_blank" rel="noopener" data-track="footer_whatsapp">WhatsApp</a></li>
          </ul>
        </div>
      </div>
      <div class="legal">
        <span class="label">© {new Date().getFullYear()} {company.name}</span>
        <span class="label">Demo de rediseño · no es el sitio oficial todavía</span>
      </div>
    </div>
  </footer>

  <a class="wa-float" href={waDefault} target="_blank" rel="noopener" data-track="float_whatsapp" aria-label="Escribir a Daymont por WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4a.5.5 0 0 0 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.7-1.2 2.2 2.2 0 0 0 .2-1.2c-.1-.1-.3-.2-.5-.3Z"/></svg>
    <span class="txt">WhatsApp</span>
  </a>

  <script>
    import '../scripts/motion.js';
    // Palette switcher (3 propuestas; la decisión se toma con el cliente)
    const root = document.documentElement;
    const buttons = document.querySelectorAll<HTMLButtonElement>('.palette button');
    const sync = () => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pal === root.dataset.palette)));
    sync();
    buttons.forEach((b) => b.addEventListener('click', () => {
      root.dataset.palette = b.dataset.pal!;
      try { localStorage.setItem('daymont-palette', b.dataset.pal!); } catch {}
      sync();
      window.dispatchEvent(new CustomEvent('palettechange', { detail: b.dataset.pal }));
      (window as any).dataLayer?.push({ event: 'palette_change', palette: b.dataset.pal });
    }));
  </script>
</body>
</html>
